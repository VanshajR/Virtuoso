{
  "name": "virtuoso-bot",
  "version": "1.0.0",
  "description": "Virtuoso - a production-ready Discord music bot",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "node -e \"console.log('Build step not required for Virtuoso')\"",
    "postinstall": "node -e \"require('yt-dlp-exec')('--version').catch(() => process.exit(0))\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "ffmpeg-static": "^4.4.1",
    "node-fetch": "^3.3.2",
    "play-dl": "^1.9.7",
    "prism-media": "^1.3.5",
    "yt-dlp-exec": "file:vendor/yt-dlp-exec"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
